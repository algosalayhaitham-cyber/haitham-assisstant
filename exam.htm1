<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>📝 إنشاء اختبار - هيثم AI</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Tahoma', 'Segoe UI', sans-serif;
            background: linear-gradient(145deg, #0b0e1a 0%, #1a1f35 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            width: 100%;
            background: rgba(255,255,255,0.06);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 30px;
            padding: 35px 30px;
            box-shadow: 0 40px 90px rgba(0,0,0,0.7);
            animation: fadeUp 0.6s ease;
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .header h1 {
            color: white;
            font-size: 28px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .header h1 span {
            background: linear-gradient(135deg, #f6b26b, #e67e22);
            padding: 3px 14px;
            border-radius: 30px;
            font-size: 14px;
            color: #0b0e1a;
        }
        .back-btn {
            background: rgba(255,255,255,0.08);
            color: white;
            border: 1px solid rgba(255,255,255,0.15);
            padding: 10px 22px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 14px;
            transition: 0.3s;
            text-decoration: none;
        }
        .back-btn:hover {
            background: rgba(255,255,255,0.15);
            transform: translateY(-2px);
        }
        .tip-box {
            background: rgba(255,215,0,0.08);
            border: 1px solid rgba(255,215,0,0.15);
            padding: 12px 18px;
            border-radius: 12px;
            margin-bottom: 20px;
            color: rgba(255,255,255,0.7);
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .tip-box strong { color: #f6b26b; }

        /* ===== إعدادات الاختبار ===== */
        .exam-settings {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }
        .exam-settings label {
            color: rgba(255,255,255,0.6);
            font-size: 13px;
            font-weight: bold;
            display: block;
            margin-bottom: 4px;
        }
        .exam-settings input, .exam-settings select {
            width: 100%;
            padding: 10px 14px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.05);
            color: white;
            font-size: 14px;
            transition: 0.3s;
        }
        .exam-settings input:focus, .exam-settings select:focus {
            outline: none;
            border-color: #f6b26b;
            background: rgba(255,255,255,0.08);
        }
        .exam-settings input::placeholder { color: rgba(255,255,255,0.3); }
        .exam-settings select option { background: #1a1f35; color: white; }

        /* ===== إضافة الأسئلة ===== */
        .section-title {
            color: white;
            font-size: 18px;
            margin: 20px 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-title small {
            color: rgba(255,255,255,0.3);
            font-size: 13px;
            font-weight: normal;
        }
        .question-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 15px;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 5px;
        }
        .question-list::-webkit-scrollbar { width: 4px; }
        .question-list::-webkit-scrollbar-thumb { background: #f6b26b; border-radius: 10px; }

        .question-item {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 14px;
            padding: 16px 18px;
            transition: 0.3s;
        }
        .question-item:hover { background: rgba(255,255,255,0.07); }
        .question-item .q-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .question-item .q-number {
            color: #f6b26b;
            font-weight: bold;
            font-size: 14px;
        }
        .question-item .q-type {
            color: rgba(255,255,255,0.3);
            font-size: 12px;
            background: rgba(255,255,255,0.05);
            padding: 2px 12px;
            border-radius: 20px;
        }
        .question-item .q-text {
            color: white;
            font-size: 15px;
            margin-bottom: 8px;
        }
        .question-item .q-options {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }
        .question-item .q-options label {
            color: rgba(255,255,255,0.5);
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }
        .question-item .q-options input[type="radio"] {
            accent-color: #f6b26b;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }
        .question-item .q-options input[type="text"] {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 6px;
            padding: 4px 10px;
            color: white;
            font-size: 13px;
            width: 100px;
        }
        .question-item .q-options input[type="text"]:focus {
            outline: none;
            border-color: #f6b26b;
        }
        .delete-q {
            background: rgba(255,0,0,0.1);
            border: 1px solid rgba(255,0,0,0.15);
            color: #ff6b6b;
            padding: 4px 12px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 12px;
            transition: 0.3s;
        }
        .delete-q:hover {
            background: rgba(255,0,0,0.2);
            transform: scale(1.05);
        }

        /* ===== أزرار ===== */
        .btn-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 10px;
        }
        .btn {
            padding: 12px 24px;
            border-radius: 30px;
            border: none;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            flex: 1;
            min-width: 120px;
            text-align: center;
        }
        .btn:hover { transform: translateY(-2px); }
        .btn-primary { background: linear-gradient(135deg, #f6b26b, #e67e22); color: #0b0e1a; }
        .btn-primary:hover { box-shadow: 0 8px 30px rgba(230,126,34,0.4); }
        .btn-success { background: linear-gradient(135deg, #48bb78, #38a169); color: white; }
        .btn-success:hover { box-shadow: 0 8px 30px rgba(72,187,120,0.4); }
        .btn-danger { background: linear-gradient(135deg, #fc8181, #f56565); color: white; }
        .btn-danger:hover { box-shadow: 0 8px 30px rgba(252,129,129,0.4); }
        .btn-outline { background: transparent; border: 1px solid rgba(255,255,255,0.15); color: white; }
        .btn-outline:hover { background: rgba(255,255,255,0.05); }

        /* ===== نتيجة الاختبار ===== */
        .result-box {
            display: none;
            margin-top: 25px;
            padding: 25px;
            background: rgba(255,255,255,0.04);
            border-radius: 18px;
            border: 1px solid rgba(255,255,255,0.06);
        }
        .result-box h2 {
            color: white;
            margin-bottom: 15px;
        }
        .result-box .score {
            font-size: 48px;
            font-weight: bold;
            color: #f6b26b;
            text-align: center;
        }
        .result-box .score small {
            font-size: 20px;
            color: rgba(255,255,255,0.3);
        }
        .result-box .result-details {
            margin-top: 15px;
        }
        .result-box .result-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.7);
            font-size: 14px;
        }
        .result-box .result-item .correct { color: #48bb78; }
        .result-box .result-item .wrong { color: #fc8181; }

        /* ===== استجابة ===== */
        @media (max-width: 600px) {
            .container { padding: 20px 15px; }
            .exam-settings { grid-template-columns: 1fr; }
            .header { flex-direction: column; align-items: stretch; text-align: center; }
            .btn-group { flex-direction: column; }
            .btn { min-width: unset; }
            .question-item .q-options { gap: 10px; }
        }
    </style>
</head>
<body>

<div class="container">

    <!-- ===== الهيدر ===== -->
    <div class="header">
        <h1>📝 إنشاء اختبار <span>موضوعي</span></h1>
        <button class="back-btn" onclick="window.location.href='home.html'">🔙 رجوع</button>
    </div>

    <!-- ===== نصائح ===== -->
    <div class="tip-box">
        💡 <strong>نصيحة:</strong> أضف أسئلة من نوع (صح/خطأ) أو (اختيار من متعدد)، ثم اضغط "تصحيح" لمعرفة النتيجة!
    </div>

    <!-- ===== إعدادات الاختبار ===== -->
    <div class="exam-settings">
        <div>
            <label>📚 اسم الاختبار</label>
            <input type="text" id="examTitle" placeholder="مثال: اختبار الرياضيات" value="اختبار الرياضيات">
        </div>
        <div>
            <label>👤 اسم الطالب</label>
            <input type="text" id="studentName" placeholder="أدخل اسم الطالب" value="أحمد محمد">
        </div>
    </div>

    <!-- ===== قائمة الأسئلة ===== -->
    <div class="section-title">
        📋 الأسئلة <small>(<span id="questionCount">0</span> سؤال)</small>
    </div>

    <div class="question-list" id="questionList">
        <!-- الأسئلة ستظهر هنا -->
    </div>

    <!-- ===== أزرار الإضافة ===== -->
    <div class="btn-group">
        <button class="btn btn-primary" onclick="addQuestion('truefalse')">✅ إضافة سؤال صح/خطأ</button>
        <button class="btn btn-primary" onclick="addQuestion('mcq')">🔘 إضافة اختيار من متعدد</button>
        <button class="btn btn-danger" onclick="clearAllQuestions()">🗑️ مسح الكل</button>
    </div>

    <!-- ===== أزرار التصحيح ===== -->
    <div class="btn-group" style="margin-top:15px;">
        <button class="btn btn-success" onclick="submitExam()">📊 تصحيح الاختبار</button>
        <button class="btn btn-outline" onclick="resetExam()">🔄 إعادة تعيين</button>
    </div>

    <!-- ===== نتيجة الاختبار ===== -->
    <div class="result-box" id="resultBox">
        <h2>📊 نتيجة الاختبار</h2>
        <div class="score" id="resultScore">0 <small>/ 0</small></div>
        <div class="result-details" id="resultDetails"></div>
    </div>

</div>

<script>
    // ================================================================
    // 1. المتغيرات
    // ================================================================
    let questions = [];
    let questionId = 0;

    // ================================================================
    // 2. إضافة سؤال
    // ================================================================
    function addQuestion(type) {
        const q = {
            id: ++questionId,
            type: type,
            text: '',
            options: type === 'mcq' ? ['', '', '', ''] : ['صح', 'خطأ'],
            correct: type === 'mcq' ? 0 : 0,
            userAnswer: null
        };

        if (type === 'truefalse') {
            q.text = 'السؤال الجديد (صح/خطأ)';
            q.correct = 0; // 0 = صح, 1 = خطأ
        } else {
            q.text = 'السؤال الجديد (اختيار من متعدد)';
            q.correct = 0; // index of correct answer
        }

        questions.push(q);
        renderQuestions();
    }

    // ================================================================
    // 3. عرض الأسئلة
    // ================================================================
    function renderQuestions() {
        const list = document.getElementById('questionList');
        list.innerHTML = '';
        document.getElementById('questionCount').textContent = questions.length;

        questions.forEach((q, index) => {
            const div = document.createElement('div');
            div.className = 'question-item';
            div.dataset.id = q.id;

            // بناء الخيارات
            let optionsHtml = '';
            if (q.type === 'truefalse') {
                optionsHtml = q.options.map((opt, i) => `
                    <label>
                        <input type="radio" name="q_${q.id}" value="${i}" onchange="setAnswer(${q.id}, ${i})">
                        ${opt}
                    </label>
                `).join('');
            } else {
                optionsHtml = q.options.map((opt, i) => `
                    <label style="display:flex;align-items:center;gap:6px;">
                        <input type="radio" name="q_${q.id}" value="${i}" onchange="setAnswer(${q.id}, ${i})">
                        <input type="text" value="${opt}" placeholder="خيار ${i+1}" 
                               onchange="updateOption(${q.id}, ${i}, this.value)" 
                               style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:4px 10px;color:white;font-size:13px;width:120px;">
                    </label>
                `).join('');
            }

            div.innerHTML = `
                <div class="q-header">
                    <span class="q-number">سؤال ${index + 1}</span>
                    <span class="q-type">${q.type === 'truefalse' ? '✅ صح/خطأ' : '🔘 اختيار من متعدد'}</span>
                    <button class="delete-q" onclick="deleteQuestion(${q.id})">✕ حذف</button>
                </div>
                <div class="q-text">
                    <input type="text" value="${q.text}" placeholder="أدخل نص السؤال..."
                           onchange="updateText(${q.id}, this.value)"
                           style="width:100%;background:transparent;border:none;color:white;font-size:15px;padding:4px 0;">
                </div>
                <div class="q-options">
                    ${optionsHtml}
                    ${q.type === 'mcq' ? `<label style="color:rgba(255,255,255,0.3);font-size:12px;">✅ الإجابة الصحيحة: 
                        <select onchange="setCorrect(${q.id}, this.value)" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:2px 8px;color:white;">
                            ${q.options.map((_, i) => `<option value="${i}" ${i === q.correct ? 'selected' : ''}>${i + 1}</option>`).join('')}
                        </select>
                    </label>` : ''}
                    ${q.type === 'truefalse' ? `<label style="color:rgba(255,255,255,0.3);font-size:12px;">✅ الإجابة الصحيحة:
                        <select onchange="setCorrect(${q.id}, this.value)" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:2px 8px;color:white;">
                            <option value="0" ${q.correct === 0 ? 'selected' : ''}>صح</option>
                            <option value="1" ${q.correct === 1 ? 'selected' : ''}>خطأ</option>
                        </select>
                    </label>` : ''}
                </div>
            `;

            list.appendChild(div);
        });
    }

    // ================================================================
    // 4. دوال التحديث
    // ================================================================
    function updateText(id, value) {
        const q = questions.find(q => q.id === id);
        if (q) q.text = value;
    }

    function updateOption(id, index, value) {
        const q = questions.find(q => q.id === id);
        if (q && q.type === 'mcq') q.options[index] = value;
    }

    function setCorrect(id, value) {
        const q = questions.find(q => q.id === id);
        if (q) q.correct = parseInt(value);
    }

    function setAnswer(id, value) {
        const q = questions.find(q => q.id === id);
        if (q) q.userAnswer = parseInt(value);
    }

    function deleteQuestion(id) {
        questions = questions.filter(q => q.id !== id);
        renderQuestions();
    }

    function clearAllQuestions() {
        if (confirm('هل تريد مسح جميع الأسئلة؟')) {
            questions = [];
            questionId = 0;
            renderQuestions();
            document.getElementById('resultBox').style.display = 'none';
        }
    }

    // ================================================================
    // 5. تصحيح الاختبار
    // ================================================================
    function submitExam() {
        const title = document.getElementById('examTitle').value || 'اختبار';
        const studentName = document.getElementById('studentName').value || 'طالب';

        // تحقق من وجود أسئلة
        if (questions.length === 0) {
            alert('❌ أضف بعض الأسئلة أولاً!');
            return;
        }

        // تحقق من أن جميع الأسئلة لها إجابة
        let allAnswered = true;
        questions.forEach(q => {
            if (q.userAnswer === null || q.userAnswer === undefined) {
                allAnswered = false;
            }
        });

        if (!allAnswered) {
            alert('❌ أجب على جميع الأسئلة أولاً!');
            return;
        }

        // حساب النتيجة
        let correct = 0;
        let total = questions.length;
        let details = [];

        questions.forEach((q, index) => {
            const isCorrect = q.userAnswer === q.correct;
            if (isCorrect) correct++;
            details.push({
                number: index + 1,
                text: q.text,
                correct: isCorrect,
                userAnswer: q.userAnswer,
                correctAnswer: q.correct,
                options: q.options
            });
        });

        const score = Math.round((correct / total) * 100);

        // عرض النتيجة
        document.getElementById('resultScore').innerHTML = `${correct} <small>/ ${total}</small>`;
        document.getElementById('resultBox').style.display = 'block';

        const detailsDiv = document.getElementById('resultDetails');
        detailsDiv.innerHTML = `
            <div style="color:rgba(255,255,255,0.5);font-size:14px;margin-bottom:10px;">
                📚 ${title} | 👤 ${studentName} | ⭐ ${score}%
            </div>
            ${details.map(d => `
                <div class="result-item">
                    <span>سؤال ${d.number}: ${d.text.substring(0, 30)}${d.text.length > 30 ? '...' : ''}</span>
                    <span class="${d.correct ? 'correct' : 'wrong'}">${d.correct ? '✅ صحيح' : '❌ خطأ'}</span>
                </div>
            `).join('')}
            <div style="margin-top:15px;padding-top:15px;border-top:1px solid rgba(255,255,255,0.06);text-align:center;color:#f6b26b;font-size:18px;font-weight:bold;">
                النتيجة النهائية: ${correct}/${total} (${score}%)
            </div>
        `;

        // تشغيل تأثير إذا كانت النتيجة ممتازة
        if (score >= 80) {
            createConfetti();
        }
    }

    // ================================================================
    // 6. إعادة تعيين
    // ================================================================
    function resetExam() {
        questions.forEach(q => q.userAnswer = null);
        renderQuestions();
        document.getElementById('resultBox').style.display = 'none';
        document.getElementById('examTitle').value = 'اختبار الرياضيات';
        document.getElementById('studentName').value = 'أحمد محمد';
    }

    // ================================================================
    // 7. تأثير Confetti
    // ================================================================
    function createConfetti() {
        const colors = ['#ff6b6b', '#ffd93d', '#6bcb77', '#4d96ff', '#ff6bd6', '#845ec2'];
        const container = document.createElement('div');
        container.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999;overflow:hidden;';
        document.body.appendChild(container);

        for (let i = 0; i < 60; i++) {
            const el = document.createElement('div');
            el.style.cssText = `
                position: absolute;
                left: ${Math.random() * 100}%;
                top: -10px;
                width: ${Math.random() * 8 + 4}px;
                height: ${Math.random() * 8 + 4}px;
                background: ${colors[Math.floor(Math.random() * colors.length)]};
                border-radius: ${Math.random() > 0.5 ? '50%' : '0'};
                animation: confettiFall ${Math.random() * 2 + 1}s linear forwards;
                animation-delay: ${Math.random() * 0.8}s;
            `;
            container.appendChild(el);
        }

        if (!document.getElementById('confettiStyle')) {
            const style = document.createElement('style');
            style.id = 'confettiStyle';
            style.textContent = `
                @keyframes confettiFall {
                    0% { transform: translateY(0) rotate(0deg); opacity: 1; }
                    100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
                }
            `;
            document.head.appendChild(style);
        }

        setTimeout(() => container.remove(), 4000);
    }

    // ================================================================
    // 8. بدء التشغيل
    // ================================================================
    renderQuestions();

    console.log('📝 صفحة إنشاء الاختبارات جاهزة!');
</script>

</body>
  </html>
