<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>إنشاء اختبار - هيثم AI</title>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {

    font-family:
        Tahoma,
        "Segoe UI",
        sans-serif;

    background:
        linear-gradient(
            135deg,
            #0f0c29,
            #302b63,
            #24243e
        );

    min-height: 100vh;

    padding: 20px;

    color: white;
}

.container {

    width: 100%;

    max-width: 900px;

    margin: auto;
}

.header {

    text-align: center;

    margin-bottom: 25px;
}

.header .icon {

    font-size: 55px;

    margin-bottom: 10px;
}

.header h1 {

    font-size: 30px;

    margin-bottom: 8px;
}

.header p {

    color:
        rgba(255,255,255,0.65);
}

.card {

    background:
        rgba(255,255,255,0.08);

    border:
        1px solid
        rgba(255,255,255,0.12);

    border-radius: 25px;

    padding: 25px;

    margin-bottom: 20px;

    box-shadow:
        0 20px 50px
        rgba(0,0,0,0.25);
}

.form-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 18px;
}

.field {

    display: flex;

    flex-direction: column;

    gap: 8px;
}

.full {

    grid-column:
        1 / -1;
}

label {

    font-weight: bold;

    color: #f6b26b;
}

input,
select,
textarea {

    width: 100%;

    padding: 14px;

    border-radius: 12px;

    border:
        1px solid
        rgba(255,255,255,0.15);

    background:
        rgba(255,255,255,0.08);

    color: white;

    font-size: 16px;

    font-family: inherit;
}

select option {

    color: black;
}

textarea {

    min-height: 110px;

    resize: vertical;
}

input:focus,
select:focus,
textarea:focus {

    outline: none;

    border-color: #667eea;
}

.generate-btn {

    width: 100%;

    margin-top: 22px;

    padding: 16px;

    border: none;

    border-radius: 14px;

    background:
        linear-gradient(
            135deg,
            #667eea,
            #764ba2
        );

    color: white;

    font-size: 18px;

    font-weight: bold;

    cursor: pointer;
}

.generate-btn:disabled {

    opacity: 0.6;

    cursor: wait;
}

.result {

    display: none;
}

.result h2 {

    color: #f6b26b;

    margin-bottom: 15px;
}

#examResult {

    background:
        rgba(0,0,0,0.15);

    padding: 20px;

    border-radius: 15px;

    line-height: 2;

    min-height: 100px;
}

.loading {

    text-align: center;

    padding: 20px;

    color: #f6b26b;
}

.back-btn {

    display: block;

    text-align: center;

    margin-top: 15px;

    padding: 13px;

    border-radius: 12px;

    background:
        rgba(255,255,255,0.08);

    color: white;

    text-decoration: none;
}

@media(max-width:600px) {

    .form-grid {

        grid-template-columns: 1fr;
    }

    .full {

        grid-column: auto;
    }

    .header h1 {

        font-size: 25px;
    }
}

</style>

</head>

<body>

<div class="container">

    <div class="header">

        <div class="icon">
            📄
        </div>

        <h1>
            إنشاء اختبار
        </h1>

        <p>
            أنشئ اختبارًا تعليميًا متكاملًا بواسطة هيثم AI
        </p>

    </div>


    <div class="card">

        <div class="form-grid">


            <div class="field">

                <label>
                    📚 المادة
                </label>

                <select id="subject">

                    <option>
                        الرياضيات
                    </option>

                    <option>
                        اللغة العربية
                    </option>

                    <option>
                        اللغة الإنجليزية
                    </option>

                    <option>
                        العلوم
                    </option>

                    <option>
                        الدراسات الاجتماعية
                    </option>

                    <option>
                        القرآن الكريم
                    </option>

                </select>

            </div>


            <div class="field">

                <label>
                    🎓 الصف
                </label>

                <select id="grade">

                    <option>
                        الصف الخامس
                    </option>

                    <option>
                        الصف السادس
                    </option>

                    <option>
                        الصف السابع
                    </option>

                    <option>
                        الصف الثامن
                    </option>

                    <option>
                        الصف التاسع
                    </option>

                    <option>
                        الأول الثانوي
                    </option>

                    <option>
                        الثاني الثانوي
                    </option>

                    <option>
                        الثالث الثانوي
                    </option>

                </select>

            </div>


            <div class="field full">

                <label>
                    📖 موضوع الاختبار
                </label>

                <textarea
                    id="topic"
                    placeholder="مثال: الكسور العشرية، المعادلات، النسبة والتناسب...">
                </textarea>

            </div>


            <div class="field">

                <label>
                    🔢 عدد الأسئلة
                </label>

                <select id="count">

                    <option value="5">
                        5 أسئلة
                    </option>

                    <option value="10" selected>
                        10 أسئلة
                    </option>

                    <option value="15">
                        15 سؤالًا
                    </option>

                    <option value="20">
                        20 سؤالًا
                    </option>

                </select>

            </div>


            <div class="field">

                <label>
                    🎯 مستوى الصعوبة
                </label>

                <select id="difficulty">

                    <option>
                        سهل
                    </option>

                    <option selected>
                        متوسط
                    </option>

                    <option>
                        صعب
                    </option>

                    <option>
                        متدرج من السهل إلى الصعب
                    </option>

                </select>

            </div>


            <div class="field full">

                <label>
                    📝 نوع الأسئلة
                </label>

                <select id="type">

                    <option>
                        اختيار من متعدد
                    </option>

                    <option>
                        صح أو خطأ
                    </option>

                    <option>
                        أسئلة متنوعة
                    </option>

                    <option>
                        أسئلة مقالية
                    </option>

                </select>

            </div>

        </div>


        <button
            class="generate-btn"
            id="generateBtn">

            🤖 إنشاء الاختبار

        </button>

    </div>


    <div
        class="card result"
        id="resultBox">

        <h2>
            📋 الاختبار الناتج
        </h2>

        <div id="examResult"></div>

    </div>


    <a
        href="index.html"
        class="back-btn">

        ⬅️ العودة إلى الصفحة الرئيسية

    </a>

</div>


<script>

const generateBtn =
    document.getElementById(
        "generateBtn"
    );

const resultBox =
    document.getElementById(
        "resultBox"
    );

const examResult =
    document.getElementById(
        "examResult"
    );


generateBtn.addEventListener(
    "click",
    async function () {

        const subject =
            document.getElementById(
                "subject"
            ).value;

        const grade =
            document.getElementById(
                "grade"
            ).value;

        const topic =
            document.getElementById(
                "topic"
            ).value.trim();

        const count =
            document.getElementById(
                "count"
            ).value;

        const difficulty =
            document.getElementById(
                "difficulty"
            ).value;

        const type =
            document.getElementById(
                "type"
            ).value;


        if (!topic) {

            alert(
                "اكتب موضوع الاختبار أولًا"
            );

            return;
        }


        generateBtn.disabled =
            true;

        generateBtn.textContent =
            "⏳ جاري إنشاء الاختبار...";


        resultBox.style.display =
            "block";


        examResult.innerHTML = `
            <div class="loading">
                🤖 هيثم AI يقوم بإعداد الاختبار...
            </div>
        `;


        const prompt = `

أنشئ اختبارًا تعليميًا متكاملًا باللغة العربية.

البيانات:

المادة:
${subject}

الصف:
${grade}

موضوع الاختبار:
${topic}

عدد الأسئلة:
${count}

مستوى الصعوبة:
${difficulty}

نوع الأسئلة:
${type}


اكتب الاختبار جاهزًا للطباعة.

ابدأ بالبيانات التالية:

اسم المدرسة: __________________________

اسم الطالب: __________________________

الصف: ${grade}

المادة: ${subject}

الدرجة: __________________________

التاريخ: __________________________


ثم اكتب الأسئلة بشكل واضح ومرقم.

إذا كان الاختبار اختيارًا من متعدد:
ضع أربعة خيارات لكل سؤال.

في النهاية ضع:

نموذج الإجابة

ثم اكتب الإجابات الصحيحة بوضوح.

لا تشرح طريقة إعداد الاختبار.
أعطني الاختبار مباشرة جاهزًا للطباعة.
`;


        try {

            const response =
                await fetch(
                    "/api/chat",
                    {

                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify({
                                message:
                                    prompt
                            })

                    }
                );


            let data;

            try {

                data =
                    await response.json();

            } catch (error) {

                throw new Error(
                    "الخادم لم يُرجع JSON صحيحًا."
                );

            }


            if (!response.ok) {

                throw new Error(
                    data.reply ||
                    "حدث خطأ أثناء إنشاء الاختبار"
                );

            }


            if (!data.reply) {

                throw new Error(
                    "لم يصل الاختبار من الذكاء الاصطناعي"
                );

            }


            examResult.innerHTML =
                formatText(
                    data.reply
                );


        } catch (error) {

            console.error(
                "Exam Error:",
                error
            );

            examResult.innerHTML = `

                <div style="
                    color:#ff8a8a;
                    line-height:1.9;
                ">

                    ❌ حدث خطأ أثناء إنشاء الاختبار

                    <br><br>

                    ${escapeHtml(
                        error.message
                    )}

                    <br><br>

                    <small>
                    إذا ظهرت مشكلة في المفتاح،
                    تأكد من وجود
                    GEMINI_API_KEY
                    في Vercel.
                    </small>

                </div>

            `;

        } finally {

            generateBtn.disabled =
                false;

            generateBtn.textContent =
                "🤖 إنشاء الاختبار";

        }

    }
);


function formatText(text) {

    return escapeHtml(text)
        .replace(
            /\n/g,
            "<br>"
        );

}


function escapeHtml(text) {

    const div =
        document.createElement(
            "div"
        );

    div.textContent =
        text;

    return div.innerHTML;

}

</script>

</body>

</html>
